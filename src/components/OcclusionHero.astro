---
// Live illustration of the Reverie question.
// Balls bounce in a box. While one is fully behind the occluder, a dashed "ghost" shows where
// constant-velocity extrapolation thinks it is. Collisions behind the occluder make the ghost wrong.
// This is an illustration of the question, not model output.
---
<figure class="occlusion">
  <div class="frame">
    <canvas id="occlusion-canvas" aria-label="Animated balls bouncing in a box, passing behind an occluder. A dashed ghost circle marks where a straight-line guess places each hidden ball."></canvas>
    <button class="pause no-print" type="button" aria-label="Pause animation">❚❚</button>
  </div>
  <figcaption>
    <span class="key"><i class="k-ball"></i> ball</span>
    <span class="key"><i class="k-ghost"></i> straight-line guess while hidden</span>
    <span class="key"><i class="k-warn"></i> collision behind the wall</span>
    <p>
      When two balls collide out of sight, no extrapolation can know. Reverie asks whether a
      learned world model keeps the hidden ball in its state anyway, and whether it uses it.
    </p>
  </figcaption>
</figure>

<script>
  type Ball = {
    x: number; y: number; vx: number; vy: number;
    hidden: boolean; ghost: null | { x: number; y: number; vx: number; vy: number; t: number };
    hc: boolean;
  };
  type Readout = { x: number; y: number; text: string; warn: boolean; life: number };

  const canvas = document.getElementById('occlusion-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const W = 2, H = 1, R = 0.05;
    const OCC = { x0: 0.8, x1: 1.2 };
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let paused = reduce;
    let scale = 1;

    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    const balls: Ball[] = [
      { x: 0.3, y: 0.3, vx: 0.42, vy: 0.27 },
      { x: 1.6, y: 0.65, vx: -0.36, vy: -0.31 },
      { x: 0.55, y: 0.75, vx: 0.3, vy: -0.4 },
    ].map((b) => ({ ...b, vx: b.vx * rand(0.9, 1.1), vy: b.vy * rand(0.9, 1.1), hidden: false, ghost: null, hc: false }));
    const readouts: Readout[] = [];
    let flash = 0;

    const isHidden = (b: { x: number }) => b.x - R > OCC.x0 && b.x + R < OCC.x1;

    function resize() {
      const w = canvas!.parentElement!.clientWidth;
      const h = w / 2;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      canvas!.style.width = w + 'px';
      canvas!.style.height = h + 'px';
      scale = (w * dpr) / W;
      ctx.setTransform(scale, 0, 0, scale, 0, 0);
    }

    function walls(p: { x: number; y: number; vx: number; vy: number }) {
      if (p.x < R) { p.x = R; p.vx = Math.abs(p.vx); }
      if (p.x > W - R) { p.x = W - R; p.vx = -Math.abs(p.vx); }
      if (p.y < R) { p.y = R; p.vy = Math.abs(p.vy); }
      if (p.y > H - R) { p.y = H - R; p.vy = -Math.abs(p.vy); }
    }

    function step(dt: number) {
      for (const b of balls) { b.x += b.vx * dt; b.y += b.vy * dt; walls(b); }
      for (let i = 0; i < balls.length; i++) {
        for (let j = i + 1; j < balls.length; j++) {
          const a = balls[i], c = balls[j];
          const dx = c.x - a.x, dy = c.y - a.y;
          const d = Math.hypot(dx, dy);
          if (d > 0 && d < 2 * R) {
            const nx = dx / d, ny = dy / d;
            const rel = (a.vx - c.vx) * nx + (a.vy - c.vy) * ny;
            if (rel > 0) {
              a.vx -= rel * nx; a.vy -= rel * ny;
              c.vx += rel * nx; c.vy += rel * ny;
              if (a.hidden || c.hidden) {
                if (a.hidden) a.hc = true;
                if (c.hidden) c.hc = true;
                flash = 1;
              }
            }
            const push = (2 * R - d) / 2;
            a.x -= nx * push; a.y -= ny * push; c.x += nx * push; c.y += ny * push;
          }
        }
      }
      for (const b of balls) {
        const h = isHidden(b);
        if (h && !b.hidden) { b.ghost = { x: b.x, y: b.y, vx: b.vx, vy: b.vy, t: 0 }; b.hc = false; }
        if (!h && b.hidden && b.ghost) {
          const miss = (Math.hypot(b.ghost.x - b.x, b.ghost.y - b.y) / W) * 100;
          readouts.push({
            x: b.x, y: b.y,
            text: b.hc ? `hidden collision · guess off by ${miss.toFixed(0)}%` : `guess off by ${miss.toFixed(1)}%`,
            warn: b.hc, life: 1,
          });
          b.ghost = null;
        }
        b.hidden = h;
        if (b.ghost) { const g = b.ghost; g.x += g.vx * dt; g.y += g.vy * dt; g.t += dt; walls(g); }
      }
      for (const r of readouts) r.life -= dt / 2.2;
      while (readouts.length && readouts[0].life <= 0) readouts.shift();
      flash = Math.max(0, flash - dt * 1.5);
    }

    const css = (v: string) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();

    function draw() {
      const ink = css('--ink'), accent = css('--accent'), warn = css('--warn');
      ctx.clearRect(0, 0, W, H);
      ctx.fillStyle = css('--canvas-bg');
      ctx.fillRect(0, 0, W, H);

      for (const b of balls) { ctx.fillStyle = ink; ctx.beginPath(); ctx.arc(b.x, b.y, R, 0, Math.PI * 2); ctx.fill(); }

      // occluder, drawn over the balls
      ctx.fillStyle = css('--occluder');
      ctx.fillRect(OCC.x0, 0, OCC.x1 - OCC.x0, H);
      ctx.save();
      ctx.beginPath(); ctx.rect(OCC.x0, 0, OCC.x1 - OCC.x0, H); ctx.clip();
      ctx.strokeStyle = css('--occluder-line'); ctx.lineWidth = 1.2 / scale; ctx.beginPath();
      for (let k = -1; k < 3; k += 0.045) { ctx.moveTo(OCC.x0 + k, 0); ctx.lineTo(OCC.x0 + k - 0.4, H); }
      ctx.stroke();
      if (flash > 0) { ctx.fillStyle = warn; ctx.globalAlpha = flash * 0.18; ctx.fillRect(OCC.x0, 0, OCC.x1 - OCC.x0, H); ctx.globalAlpha = 1; }
      ctx.restore();

      // ghosts
      for (const b of balls) {
        if (!b.ghost) continue;
        const g = b.ghost;
        ctx.strokeStyle = accent;
        ctx.globalAlpha = 0.22;
        ctx.lineWidth = 1 / scale;
        ctx.beginPath(); ctx.arc(g.x, g.y, R + g.t * 0.05, 0, Math.PI * 2); ctx.stroke();
        ctx.globalAlpha = 1;
        ctx.setLineDash([4 / scale, 3 / scale]);
        ctx.lineWidth = 1.6 / scale;
        ctx.beginPath(); ctx.arc(g.x, g.y, R, 0, Math.PI * 2); ctx.stroke();
        ctx.setLineDash([]);
        if (b.hc) { ctx.fillStyle = warn; ctx.beginPath(); ctx.arc(g.x, g.y, R * 0.22, 0, Math.PI * 2); ctx.fill(); }
      }

      // readouts
      ctx.save();
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      const dpr = canvas!.width / canvas!.clientWidth;
      ctx.font = `${11 * dpr}px "JetBrains Mono", ui-monospace, monospace`;
      for (const r of readouts) {
        ctx.globalAlpha = Math.min(1, r.life * 2);
        ctx.fillStyle = r.warn ? warn : accent;
        const px = r.x * scale, py = r.y * scale;
        const tw = ctx.measureText(r.text).width;
        const tx = Math.min(Math.max(px - tw / 2, 6 * dpr), canvas!.width - tw - 6 * dpr);
        const ty = py < 40 * dpr ? py + 28 * dpr : py - 16 * dpr;
        ctx.fillText(r.text, tx, ty);
      }
      ctx.globalAlpha = 1;
      ctx.fillStyle = css('--ink-faint');
      ctx.fillText('OCCLUDER', OCC.x0 * scale + 8 * dpr, 18 * dpr);
      ctx.restore();
    }

    let last = performance.now();
    function loop(now: number) {
      const dt = Math.min(0.033, (now - last) / 1000);
      last = now;
      if (!paused) { step(dt / 2); step(dt / 2); }
      draw();
      requestAnimationFrame(loop);
    }

    resize();
    window.addEventListener('resize', resize);
    if (reduce) { for (let i = 0; i < 120; i++) step(0.016); }
    requestAnimationFrame(loop);

    const btn = document.querySelector('.occlusion .pause') as HTMLButtonElement | null;
    const label = () => { if (btn) { btn.textContent = paused ? '▶' : '❚❚'; btn.setAttribute('aria-label', paused ? 'Play animation' : 'Pause animation'); } };
    label();
    btn?.addEventListener('click', () => { paused = !paused; last = performance.now(); label(); });
  }
</script>

<style>
  .occlusion { margin: 0; }
  .frame { position: relative; border: 1px solid var(--rule); border-radius: 16px; overflow: hidden; box-shadow: var(--shadow); background: var(--canvas-bg); }
  canvas { display: block; width: 100%; }
  .pause { position: absolute; right: 10px; bottom: 10px; width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--rule); background: var(--bg-raised); color: var(--ink-soft); font-size: .7rem; cursor: pointer; }
  .pause:hover { color: var(--accent); border-color: var(--accent); }
  figcaption { margin-top: .9rem; font-size: .95rem; color: var(--ink-soft); }
  figcaption p { margin: .6rem 0 0; max-width: 60ch; }
  .key { display: inline-flex; align-items: center; gap: .4em; margin-right: 1.1rem; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: .7rem; letter-spacing: .04em; color: var(--ink-faint); }
  .key i { display: inline-block; width: 10px; height: 10px; border-radius: 50%; }
  .k-ball { background: var(--ink); }
  .k-ghost { border: 1.5px dashed var(--accent); }
  .k-warn { background: var(--warn); }
</style>
