---
import Base from '../layouts/Base.astro';
import KeepsakeHero from '../components/KeepsakeHero.astro';
import { site, links, banner, themes, paperLab, project, arxiv, riddles, writing, fmtDate, COHERE_IMG } from '../data/site';

const latest = [...writing].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 4);
const ext = (h: string) => (h.startsWith('http') ? '_blank' : undefined);

const contact = [
  { label: 'Email', href: `mailto:${site.email}` },
  { label: 'CV', href: '/cv' },
  { label: 'Writing', href: '/writing' },
  { label: 'GitHub', href: links.github },
  { label: 'LinkedIn', href: links.linkedin },
  { label: 'Hugging Face', href: links.huggingface },
  { label: 'The Meta Gradient', href: links.substack },
];

const work = [
  {
    title: project.name,
    sub: project.paperTitle,
    status: 'In progress · preprint planned for December 2026',
    href: project.anchor,
    thumb: 'keepsake',
    tags: [{ label: 'Abstract', href: project.anchor }, { label: 'Lab', href: '/lab' }],
  },
  {
    title: 'CulturalRiddles',
    sub: 'A Multicultural Benchmark of Riddles. Co-first author and cross-team lead, with the Cohere Labs Open Science Community.',
    status: 'arXiv preprint (Oct 2026) · MRL 2026 · under review at TACL',
    href: arxiv.url || '/research#culturalriddles',
    thumb: COHERE_IMG,
    tags: [
      { label: 'Paper', href: arxiv.url },
      { label: 'Blog', href: riddles.blog },
      { label: 'Dashboard', href: riddles.dashboard },
      { label: 'Dataset', href: riddles.dataset },
    ],
  },
];
---
<Base>
  <div class="banner" style={`background-image: url('${banner.src}')`} role="img" aria-label="A raked circle in a Japanese zen garden">
    <a class="credit" href={banner.page} target="_blank" rel="noopener">Photo: {banner.credit} / Pexels</a>
  </div>
  <section class="intro narrow">
    <img class="photo" src={site.photo} alt="Portrait of Vinod Anbalagan" width="200" height="200" />
    <div class="who">
      <h1>Vinod Anbalagan</h1>
      <p class="role">ML engineer and independent researcher · world models and robot learning · Toronto</p>
      <ul class="contact">
        {contact.map((c) => <li><a href={c.href} target={ext(c.href)} rel="noopener">{c.label}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="narrow about">
    {site.about.map((p) => <p>{p}</p>)}
    <p class="now">
      Right now I am building <a href={project.anchor}>{project.name}</a>: {project.question.toLowerCase()}{' '}
      It tests whether a world model's own surprise is a good guide to what goes into a small, fixed memory
      for real-time planning.
    </p>
  </section>

  <section class="narrow figure-block">
    <KeepsakeHero />
  </section>

  <section class="narrow block-s">
    <h2 class="sec">Research themes</h2>
    <div class="themes">
      {themes.map((t, i) => (
        <div class="theme">
          <span class="num">0{i + 1}</span>
          <h3>{t.title}</h3>
          <p>{t.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="narrow block-s">
    <h2 class="sec">Research</h2>
    <ul class="list">
      {work.map((w) => (
        <li>
          <a class="thumb" href={w.href} target={ext(w.href)} rel="noopener" aria-hidden="true" tabindex="-1">
            {w.thumb === 'keepsake'
              ? <svg viewBox="0 0 120 75" class="ks"><rect x="14" y="40" width="16" height="16" rx="2"/><rect x="52" y="40" width="16" height="16" rx="2"/><rect x="90" y="40" width="16" height="16" rx="2" class="ghost"/><circle cx="60" cy="22" r="6" class="agent"/><path d="M8 66 H112" class="line"/></svg>
              : <img src={w.thumb} alt="" loading="lazy" />}
          </a>
          <div>
            <h3><a href={w.href} target={ext(w.href)} rel="noopener">{w.title}</a></h3>
            <p class="sub">{w.sub}</p>
            <p class="status">{w.status}</p>
            <p class="tags">{w.tags.filter((t) => t.href).map((t) => <a href={t.href} target={ext(t.href)} rel="noopener">{t.label}</a>)}</p>
          </div>
        </li>
      ))}
    </ul>
    <p class="more"><a href="/research">All research →</a> <a href="/lab">The Lab: {paperLab.length} steps toward {project.name} →</a></p>
  </section>

  <section class="narrow block-s">
    <h2 class="sec">Writing</h2>
    <ul class="list">
      {latest.map((e) => (
        <li>
          <a class="thumb" href={e.href} target="_blank" rel="noopener" aria-hidden="true" tabindex="-1">
            {e.img ? <img src={e.img} alt="" loading="lazy" /> : <span class="blank" />}
          </a>
          <div>
            <h3><a href={e.href} target="_blank" rel="noopener">{e.title}</a></h3>
            <p class="sub">{e.dek}</p>
            <p class="status">{e.byline ?? 'The Meta Gradient'} · {fmtDate(e.date)}</p>
          </div>
        </li>
      ))}
    </ul>
    <p class="more"><a href="/writing">All writing →</a></p>
  </section>

  <section class="narrow block-s">
    <h2 class="sec">Opportunities</h2>
    <p class="open">{site.openTo}</p>
    <p class="open">The easiest way to reach me is <a href={`mailto:${site.email}`}>email</a> or a <a href={links.linkedin} target="_blank" rel="noopener">LinkedIn message</a>.</p>
  </section>
</Base>

<style>
  .banner {
    position: relative; height: clamp(170px, 24vw, 300px);
    background-size: cover; background-position: center 80%;
    background-color: var(--bg-soft);
  }
  .banner::after { content: ''; position: absolute; inset: auto 0 0 0; height: 45%; background: linear-gradient(to bottom, transparent, var(--bg)); }
  .credit { position: absolute; right: 12px; top: 10px; z-index: 1; font-family: 'Inter', system-ui, sans-serif; font-size: .68rem; color: #fff; opacity: .8; text-decoration: none; text-shadow: 0 1px 3px #0008; }
  .credit:hover { opacity: 1; color: #fff; }
  .intro { position: relative; z-index: 2; display: flex; align-items: flex-end; gap: clamp(1.4rem, 4vw, 2.4rem); margin-top: calc(-1 * clamp(70px, 9vw, 110px)); padding: 0 0 1.6rem; }
  .photo { border: 5px solid var(--bg); box-shadow: 0 2px 14px #0000001a; }
  .photo { width: 200px; height: 200px; border-radius: 50%; object-fit: cover; flex: none; background: var(--bg-soft); }
  .intro h1 { font-size: clamp(2.2rem, 5vw, 3rem); margin-bottom: .35rem; }
  .role { color: var(--ink-soft); margin: 0 0 .9rem; font-size: 1.08rem; }
  .contact { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .35rem .5rem; font-family: 'Inter', system-ui, sans-serif; font-size: .82rem; }
  .contact a { display: inline-block; text-decoration: none; padding: .25em .75em; border: 1px solid var(--rule); border-radius: 999px; color: var(--ink-soft); }
  .contact a:hover { border-color: var(--accent); color: var(--accent); }
  @media (max-width: 600px) { .intro { flex-direction: column; align-items: flex-start; } .photo { width: 150px; height: 150px; } }

  .about p { font-size: 1.12rem; line-height: 1.65; }
  .about .now { color: var(--ink-soft); }
  .figure-block { margin: 1.6rem auto 0; }

  .block-s { margin-top: clamp(2.8rem, 6vw, 4rem); }
  .sec { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: .74rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-faint); font-weight: 500; padding-bottom: .6rem; border-bottom: 1px solid var(--rule); margin: 0 0 1.2rem; }

  .themes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.4rem; }
  .theme h3 { font-size: 1.12rem; margin: .3rem 0 .4rem; }
  .theme p { font-size: .97rem; color: var(--ink-soft); margin: 0; }
  .num { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: .7rem; color: var(--accent); }
  @media (max-width: 680px) { .themes { grid-template-columns: 1fr; } }

  .list { list-style: none; padding: 0; margin: 0; }
  .list li { display: grid; grid-template-columns: 168px minmax(0, 1fr); gap: 1.3rem; padding: 1.1rem 0; border-bottom: 1px solid var(--rule); align-items: start; }
  .list li:last-child { border-bottom: 0; }
  .thumb { display: block; aspect-ratio: 16 / 10; border-radius: 8px; overflow: hidden; background: var(--bg-soft); border: 1px solid var(--rule); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s ease; }
  .thumb:hover img { transform: scale(1.03); }
  .list h3 { font-size: 1.22rem; margin: 0 0 .3rem; line-height: 1.25; }
  .list h3 a { text-decoration: none; }
  .list .sub { color: var(--ink-soft); font-size: 1rem; margin: 0 0 .35rem; }
  .list .status { font-family: 'Inter', system-ui, sans-serif; font-size: .8rem; color: var(--ink-faint); margin: 0 0 .3rem; }
  .tags { display: flex; flex-wrap: wrap; gap: .3rem .9rem; font-family: 'Inter', system-ui, sans-serif; font-size: .82rem; margin: 0; }
  .tags a { color: var(--accent); text-decoration: none; }
  .tags a:hover { text-decoration: underline; }
  @media (max-width: 600px) { .list li { grid-template-columns: 110px minmax(0, 1fr); gap: .9rem; } }

  .ks { width: 100%; height: 100%; display: block; }
  .ks rect { fill: var(--occluder); stroke: var(--occluder-line); }
  .ks rect.ghost { fill: none; stroke: var(--accent); stroke-dasharray: 3 2.5; }
  .ks .agent { fill: var(--ink); }
  .ks .line { stroke: var(--rule); }

  .more { font-family: 'Inter', system-ui, sans-serif; font-size: .88rem; margin-top: .8rem; display: flex; flex-wrap: wrap; gap: .4rem 1.4rem; }
  .more a { color: var(--ink-soft); text-decoration: none; }
  .more a:hover { color: var(--accent); }
  .open { color: var(--ink-soft); max-width: 62ch; }
</style>
