---
import Base from '../layouts/Base.astro';
import { site, links, arxiv, riddles } from '../data/site';

// Content mirrors Resume_Vinod_Anbalagan (Oct 2026). Phone number intentionally left off the web version.
const HF = 'https://huggingface.co/';
const SUB = links.substack + '/p/';

type Link = { label: string; href: string };
const ext = (h: string) => (h.startsWith('http') ? '_blank' : undefined);

const interests = ['World models for embodied agents', 'Model-based RL and robot learning', 'Memory for real-time planning', 'Representation learning and probing'];

const publications = [
  {
    title: 'A Multicultural Benchmark of Riddles',
    authors: 'V. Anbalagan et al.',
    venue: `${arxiv.id ? `arXiv:${arxiv.id}, 2026` : 'arXiv preprint, 2026'} · To be presented at MRL 2026 (Workshop on Multilingual Representation Learning), Budapest · under review at TACL`,
    links: [...(arxiv.url ? [{ label: arxiv.id ? `arXiv:${arxiv.id}` : 'arXiv', href: arxiv.url }] : []), { label: 'Research blog (co-author)', href: riddles.blog }, { label: 'Dashboard', href: riddles.dashboard }, { label: 'Dataset', href: riddles.dataset }] as Link[],
  },
];

const experience = [
  {
    role: 'Co-First Author & Cross-Team Lead',
    org: 'Cohere Labs Open Science Community · Remote',
    date: 'Apr 2026 to present',
    points: [
      'Lead the Multicultural Riddles Benchmark: ~6,100 natively written, human-evaluated riddles across 51 languages and 62 communities, designed to separate surface fluency from cultural understanding; coordinate 200+ contributors across writing, validation, and evaluation, including 165 riddle writers.',
      'Owned data integrity across 28 evaluated models: found scoring-definition and coverage issues that were inflating reported results, added automated reconciliation checks, and ran an annotation audit that led to re-validating one community whose scores were unreliable.',
      'Built the self-serve contribution pipeline: fork-based submissions validated on every pull request with GitHub Actions, tooling that turns validator output into contributor-ready feedback, and a one-command publisher that ships versioned Hugging Face releases with contributor credits and ISO language codes.',
      'Built a public results dashboard on Hugging Face Spaces with per-model, per-culture, difficulty, and error-type views, every figure reconciled to the human-evaluation source data.',
    ],
  },
  {
    role: 'Independent Researcher, World Models & Embodied AI',
    org: 'The Meta Gradient · Toronto',
    date: 'Oct 2025 to present',
    points: [
      'Keepsake (in progress): testing whether a latent world-model planner can stay reliable on long tasks by remembering only what surprises it, writing to a small fixed memory when its own prediction fails, and measuring task success against planning time per decision. Simulation first, then a low-cost robot arm.',
      'Building memory-dependent variants of standard world-model planning tasks, with ground-truth task state for controlled comparisons; studying imitation learning and VLAs in MuJoCo and LeRobot alongside.',
      'Publish The Meta Gradient, technical essays with derivations, code, and interactive demos; a VAE explainer post reached 34,000+ LinkedIn impressions.',
    ],
  },
  {
    role: 'Machine Learning Engineer Intern',
    org: 'M2M Tech · Vancouver (Remote)',
    date: 'Feb 2025 to Oct 2025',
    points: [
      'Built end-to-end Python ML pipelines covering data cleaning, feature engineering, XGBoost training, hyperparameter tuning, and probability calibration.',
      'Evaluated models through structured experiments and deployed real-time inference with Docker, FastAPI, and Hugging Face Spaces.',
    ],
  },
  {
    role: 'Buyer / Procurement Analyst',
    org: 'Whole Foods Market · Toronto',
    date: 'Nov 2021 to Apr 2023',
    points: [
      'Forecast demand and managed inventory for a perishable category against a $50K monthly budget, where forecast errors carried direct operational cost.',
      'Analyzed sales, waste, inventory, and vendor performance to balance availability against demand and reduce shrink.',
    ],
  },
];

const projects = [
  {
    title: 'Gridline & Prism: Vision-Language Fine-Tuning for Chart QA',
    org: 'Adaption Labs AutoScientist Challenge · 2nd Place',
    date: '2026',
    points: [
      'Built two correct-by-construction chart-QA datasets (one visual style, then ten) with a hand-authored hardset from real StatCan, BLS, ECB, and WHO charts and eight perceptual-difficulty mechanics (truncated and log axes, unlabeled values, near-ties, dual axes).',
      'Fine-tuned LoRA adapters on Gemma-3-27B and Qwen3.5-9B vision-language models across 15 training runs; Gridline won 62% of pairwise comparisons against its base model.',
      'Showed the challenge’s win-rate metric partly rewards easier test sets: with the base model fixed, win rate fell from 62% to 24% as perceptual difficulty and visual variety increased.',
      'Diagnosed a reproducible failure where maximal data-enhancement settings made fine-tuned models worse than their base (31–35% win rate): even with explicit guard instructions, 31.6% of the platform’s rewritten answers diverged from source, including 41 changed numbers.',
    ],
    links: [
      { label: 'Dataset v1', href: HF + 'datasets/vinod-anbalagan/gridline-chartqa' },
      { label: 'Dataset v2', href: HF + 'datasets/vinod-anbalagan/adaption-charts-p2-gold' },
      { label: 'Gridline model', href: HF + 'vinod-anbalagan/gridline' },
      { label: 'Prism model', href: HF + 'vinod-anbalagan/prism' },
    ] as Link[],
  },
  {
    title: 'DocuNative: Offline Cross-Lingual Document QA',
    org: 'Cohere Expedition Hackathon',
    date: 'Mar 2026',
    points: [
      'Privacy-first document QA for newcomers: ask about a foreign-language document in your own language and get answers with source quotes and a hallucination trust score, with nothing leaving the device.',
      'Pipeline lead on a 7-person team: RAG with BGE-M3, ChromaDB, Tiny Aya via llama.cpp, and mDeBERTa NLI verification; 9,000+ evaluations across Chinese, Hindi, and Polish showed cross-lingual embedding quality, not LLM capability, was the main bottleneck.',
    ],
    links: [
      { label: 'Project', href: 'https://github.com/docunative-AI/docunative' },
      { label: 'Write-up', href: SUB + 'on-building-offline-ai-for-people' },
    ] as Link[],
  },
  {
    title: 'Agricultural Advisory Datasets',
    org: 'Adaption Labs Uncharted Data Challenge · Grade A (9.4/10)',
    date: '2026',
    points: [
      '187 curated Tamil Q&A records (48 crops, 20 categories) from Kisan Call Centre logs, TNAU, and ICAR sources over 10 iterative submissions, with honorary recognition from Sara Hooker; extended to 718 records in 11 Indian languages using a layered regex and local LLM-as-judge filter.',
    ],
    links: [
      { label: 'Tamil', href: HF + 'datasets/vinod-anbalagan/tamil-agri-advisory-qa' },
      { label: '11-language', href: HF + 'datasets/vinod-anbalagan/indian-agri-advice-multilingual' },
    ] as Link[],
  },
];

const essays = [
  { t: 'The Architecture of Dreams', d: 'How neural networks learned to imagine', h: SUB + 'the-architecture-of-dreams-how-neural' },
  { t: 'Freezing the Noise', d: 'How one line of algebra made sampling differentiable', h: SUB + 'freezing-the-noise' },
  { t: 'Finding the Manifold', d: 'Where neural networks land, with a live demo', h: SUB + 'finding-the-manifold-where-neural' },
];

const skills = [
  ['ML / Deep Learning', 'PyTorch · JAX · Hugging Face Transformers · LoRA/PEFT · VLM fine-tuning · scikit-learn · XGBoost'],
  ['Research & Evaluation', 'Experiment design · benchmark construction · LLM/VLM evaluation · LLM-as-judge · error analysis · data validation'],
  ['Retrieval & NLP', 'RAG · embeddings · ChromaDB · multilingual NLP'],
  ['ML Engineering', 'Docker · FastAPI · GitHub Actions · MLflow · Weights & Biases · AWS · Git · Hugging Face Hub and Spaces · Gradio · llama.cpp'],
  ['Programming & Viz', 'Python · SQL · Bash · Matplotlib · Plotly'],
];

const education = [
  { d: 'Machine Learning Foundations', s: 'University of Toronto', y: 'Mar 2025 to Jul 2025' },
  { d: 'MASc, Electronic & Computer Science Engineering', s: 'University of Windsor', y: '2010 to 2012', n: 'Thesis: An Exploration of the Feasibility of FPGA Implementation of Face Recognition using Eigenfaces' },
  { d: 'BE, Electronics & Communication Engineering', s: 'Anna University', y: '2004 to 2008' },
];

const certs = [
  'Cohere Labs ML Summer School (2026)',
  'NVIDIA AI Infrastructure and Operations Fundamentals (2025)',
  'Stanford Online Machine Learning Specialization (2025)',
  'Microsoft Azure AI-900 (2025)',
  'OpenEDG Python Professional Certificate (2025)',
];

const contact = [
  { label: 'Email', value: site.email, href: `mailto:${site.email}` },
  { label: 'LinkedIn', value: 'in/vinod-anbalagan', href: links.linkedin },
  { label: 'GitHub', value: 'VinodAnbalagan', href: links.github },
  { label: 'Hugging Face', value: 'vinod-anbalagan', href: links.huggingface },
  { label: 'Substack', value: 'The Meta Gradient', href: links.substack },
];
---
<Base title="CV" description="Curriculum vitae of Vinod Anbalagan, machine learning engineer and research engineer working on world models and representation learning.">
  <div class="wrap cv">
    <aside class="side">
      <div class="sticky">
        <p class="eyebrow">Curriculum vitae</p>
        <h1>Vinod<br />Anbalagan</h1>
        <p class="headline">Machine Learning Engineer · Research Engineer</p>
        <p class="meta">Toronto, Canada</p>

        <ul class="contact">
          {contact.map((c) => (
            <li><span class="meta">{c.label}</span><a href={c.href} target={ext(c.href)} rel="noopener">{c.value}</a></li>
          ))}
        </ul>

        <button class="btn no-print" type="button" onclick="window.print()">Save as PDF <span class="arrow">↓</span></button>

        <div class="skills">
          <p class="eyebrow">Skills</p>
          <dl>
            {skills.map(([k, v]) => (<><dt class="mono">{k}</dt><dd>{v}</dd></>))}
          </dl>
        </div>
      </div>
    </aside>

    <div class="main">
      <section>
        <p class="summary">
          Machine learning engineer and independent researcher working on one question: when a model succeeds,
          has it learned the structure of the problem, or cues that happen to correlate with it? I build the
          datasets and probes that answer it, and am now taking it into world models and model-based learning
          for embodied agents.
        </p>
        <p class="dim">
          Co-first author and cross-team lead on a 51-language benchmark with the Cohere Labs Open Science
          Community; 2nd place in the Adaption Labs AutoScientist Challenge.
        </p>
      </section>

      <section>
        <h2 class="sec">Research interests</h2>
        <ul class="interests">{interests.map((i) => <li>{i}</li>)}</ul>
      </section>

      <section>
        <h2 class="sec">Publications</h2>
        {publications.map((p) => (
          <div class="entry">
            <h3>{p.title}</h3>
            <p class="org">{p.authors}</p>
            <p class="venue">{p.venue}</p>
            <p class="links">{p.links.map((l) => (<a class="chip" href={l.href} target={ext(l.href)} rel="noopener">{l.label} ↗</a>))}</p>
          </div>
        ))}
      </section>

      <section>
        <h2 class="sec">Research &amp; professional experience</h2>
        {experience.map((e) => (
          <div class="entry">
            <div class="head">
              <h3>{e.role}</h3>
              <span class="meta">{e.date}</span>
            </div>
            <p class="org">{e.org}</p>
            <ul>{e.points.map((p) => <li>{p}</li>)}</ul>
          </div>
        ))}
        <p class="more">Earlier career: supply chain operations, procurement analysis, and process optimization.</p>
      </section>

      <section>
        <h2 class="sec">Selected projects</h2>
        {projects.map((w) => (
          <div class="entry">
            <div class="head">
              <h3>{w.title}</h3>
              <span class="meta">{w.date}</span>
            </div>
            <p class="org">{w.org}</p>
            <ul>{w.points.map((p) => <li>{p}</li>)}</ul>
            <p class="links">
              {w.links.map((l) => (<a class="chip" href={l.href} target={ext(l.href)} rel="noopener">{l.label} ↗</a>))}
            </p>
          </div>
        ))}
      </section>

      <section>
        <h2 class="sec">Selected writing · The Meta Gradient</h2>
        <ul class="plain">
          {essays.map((e) => (<li><a href={e.h} target="_blank" rel="noopener">{e.t}</a> <span class="dim">· {e.d}</span></li>))}
        </ul>
      </section>

      <section>
        <h2 class="sec">Education</h2>
        {education.map((e) => (
          <div class="entry tight">
            <div class="head"><h3>{e.d}</h3><span class="meta">{e.y}</span></div>
            <p class="org">{e.s}</p>
            {e.n && <p class="dim">{e.n}</p>}
          </div>
        ))}
        <h2 class="sec">Certifications</h2>
        <ul class="certs">{certs.map((c) => <li>{c}</li>)}</ul>
      </section>
    </div>
  </div>
</Base>

<style>
  .cv { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: clamp(2rem, 5vw, 4.5rem); padding: clamp(3rem, 7vw, 5rem) 0 2rem; }
  .sticky { position: sticky; top: 90px; }
  .side h1 { font-size: clamp(2.2rem, 4vw, 2.9rem); margin-bottom: .9rem; }
  .headline { color: var(--ink-soft); font-size: 1.05rem; line-height: 1.45; margin-bottom: .3rem; }
  .contact { list-style: none; padding: 0; margin: 1.6rem 0; border-top: 1px solid var(--rule); }
  .contact li { display: grid; grid-template-columns: 92px 1fr; align-items: baseline; padding: .45rem 0; border-bottom: 1px solid var(--rule); font-family: 'Inter', system-ui, sans-serif; font-size: .88rem; }
  .contact a { text-decoration: none; overflow-wrap: anywhere; }
  .contact a:hover { color: var(--accent); }
  .skills { margin-top: 2rem; }
  dl { margin: 0; }
  dt { font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; color: var(--accent); margin-top: .8rem; }
  dd { margin: .15rem 0 0; font-family: 'Inter', system-ui, sans-serif; font-size: .85rem; color: var(--ink-soft); line-height: 1.5; }

  .main section { margin-bottom: 2.6rem; }
  .summary { font-size: clamp(1.2rem, 2vw, 1.4rem); line-height: 1.55; }
  .sec { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: .74rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-faint); font-weight: 500; padding-bottom: .6rem; border-bottom: 1px solid var(--rule); margin: 0 0 1.3rem; }
  .entry { margin-bottom: 1.6rem; }
  .entry.tight { margin-bottom: 1rem; }
  .head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .entry h3 { font-size: 1.22rem; }
  .org { font-family: 'Inter', system-ui, sans-serif; font-size: .88rem; color: var(--accent); margin: .2rem 0 .5rem; }
  .entry p, .entry li { color: var(--ink-soft); font-size: 1.02rem; }
  .entry ul { padding-left: 1.1rem; margin: 0 0 .5rem; }
  .interests { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .4rem 1.4rem; }
  .interests li { font-size: 1.05rem; }
  .interests li::before { content: '○ '; color: var(--accent); }
  .venue { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: .74rem !important; color: var(--ink-faint) !important; margin: 0 0 .6rem; }
  .entry li { margin-bottom: .3rem; }
  .entry li::marker { color: var(--ink-faint); }
  .links { display: flex; gap: .5rem; flex-wrap: wrap; }
  .chip { font-family: 'Inter', system-ui, sans-serif; font-size: .78rem; text-decoration: none; padding: .25em .7em; border: 1px solid var(--rule); border-radius: 999px; color: var(--ink-soft); }
  .chip:hover { border-color: var(--accent); color: var(--accent); }
  .more, .dim { color: var(--ink-soft); font-size: .98rem; }
  .plain { list-style: none; padding: 0; margin: 0; }
  .plain li { padding: .35rem 0; }
  .certs { columns: 2; padding-left: 1.1rem; color: var(--ink-soft); font-size: .98rem; }
  .certs li { margin-bottom: .25rem; }

  @media (max-width: 860px) {
    .cv { grid-template-columns: 1fr; }
    .sticky { position: static; }
  }
  @media print {
    .cv { grid-template-columns: 210px 1fr; gap: 1.5rem; padding: 0; }
    .sticky { position: static; }
    .chip { border: 0; padding: 0; }
    .entry { break-inside: avoid; }
  }
</style>
