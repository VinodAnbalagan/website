---
import Base from '../layouts/Base.astro';
import { reverieLab, afterLab, labPrinciples } from '../data/site';

const statusLabel = { planned: 'Planned', next: 'Up next', building: 'In progress', shipped: 'Live' } as const;
const shipped = reverieLab.filter((p) => p.status === 'shipped').length;
---
<Base title="Lab" description="Building a world model, one component at a time, toward one question: does a world model keep track of what it cannot see, and does it use it?">
  <header class="page-head wrap">
    <p class="eyebrow">The Lab · {shipped} of {reverieLab.length} toward the Reverie paper</p>
    <h1>Building a world model,<br />one component at a time.</h1>
    <p class="lede">
      Toward one question: does a world model keep track of what it cannot see, and does it use it?
    </p>
  </header>

  <section class="wrap principles">
    {labPrinciples.map(([h, d], i) => (
      <div class="reveal">
        <span class="mono idx">0{i + 1}</span>
        <h3>{h}</h3>
        <p>{d}</p>
      </div>
    ))}
  </section>

  <section class="wrap ladder">
    <h2 class="sec-title">The Reverie paper</h2>
    <ol>
      {reverieLab.map((p) => {
        const Tag = p.href ? 'a' : 'div';
        return (
          <li class:list={['reveal', p.status]}>
            <span class="node mono">{p.n}</span>
            <Tag class="item card" href={p.href}>
              <div class="top">
                <span class="pill theme">{p.theme}</span>
                <span class:list={['pill', { live: p.status !== 'planned' }]}>{statusLabel[p.status]}</span>
              </div>
              <h3>{p.title}</h3>
              <p class="q">{p.question}</p>
              {p.ladder && <p class="meta">Scaling ladder · {p.ladder}</p>}
            </Tag>
          </li>
        );
      })}
      <li class="reveal destination">
        <span class="node mono">→</span>
        <a class="item card" href="/research#reverie">
          <div class="top"><span class="pill live">Capstone</span><span class="pill">Research</span></div>
          <h3>Reverie</h3>
          <p class="q">Does the model represent what it can't see, and does intervening on that representation change what it predicts?</p>
          <p class="meta">The write-up of all five</p>
        </a>
      </li>
    </ol>
  </section>

  <section class="wrap after reveal">
    <h2 class="sec-title">After the paper</h2>
    <ul>
      {afterLab.map((x) => (
        <li>
          <span class="t">{x.title}</span>
          {x.note && <span class="d">{x.note}</span>}
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .page-head .lede { max-width: 58ch; }
  .principles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; padding: 1rem 0 3rem; border-bottom: 1px solid var(--rule); }
  .principles h3 { font-size: 1.1rem; margin: .4rem 0 .3rem; }
  .principles p { font-size: .95rem; color: var(--ink-soft); margin: 0; }
  .idx { font-size: .7rem; color: var(--accent); }
  @media (max-width: 860px) { .principles { grid-template-columns: 1fr 1fr; } }

  .ladder ol { list-style: none; margin: 3rem 0 0; padding: 0; position: relative; }
  .ladder ol::before { content: ''; position: absolute; left: 22px; top: 10px; bottom: 30px; width: 1px; background: linear-gradient(var(--rule), var(--accent)); }
  .ladder li { display: grid; grid-template-columns: 46px 1fr; gap: 1.2rem; margin-bottom: 1.1rem; }
  .node {
    position: relative; z-index: 1; width: 46px; height: 46px; border-radius: 50%;
    display: grid; place-items: center; font-size: .8rem;
    background: var(--bg); border: 1px solid var(--rule); color: var(--ink-faint);
  }
  li.next .node, li.building .node { border-color: var(--accent); color: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  li.shipped .node { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  li.destination .node { background: var(--ink); color: var(--bg); border-color: var(--ink); }

  .item { padding: 1.3rem 1.5rem; }
  li.planned .item { opacity: .78; box-shadow: none; }
  li.planned .item:hover { opacity: 1; }
  .top { display: flex; flex-wrap: wrap; gap: .4rem; }
  .theme { color: var(--ink-faint); }
  .item h3 { margin: .8rem 0 .35rem; font-size: 1.45rem; }
  .q { color: var(--ink-soft); margin-bottom: .6rem; }
  .item .meta { margin: 0; }

  .sec-title { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: .74rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-faint); font-weight: 500; margin: 3rem 0 0; }
  .ladder ol { margin-top: 1.5rem; }
  .after { margin-top: 3.5rem; padding-top: .5rem; border-top: 1px solid var(--rule); }
  .after ul { list-style: none; padding: 0; margin: 1.2rem 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: .1rem 2rem; }
  .after li { display: grid; gap: .1rem; padding: .8rem 0; border-bottom: 1px solid var(--rule); }
  .after .t { font-size: 1.15rem; color: var(--ink-soft); }
  .after .d { font-size: .92rem; color: var(--ink-faint); }
</style>
